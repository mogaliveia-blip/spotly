rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerForUser(userId) {
      let userPath = /databases/(default)/documents/users/$(userId);
      return firestore.exists(userPath) && firestore.get(userPath).data.role == 'owner';
    }

    function isOwner() {
      return isSignedIn() ? isOwnerForUser(request.auth.uid) : false;
    }

    function isEventPublished(eventId) {
      return firestore.exists(
        /databases/(default)/documents/events/$(eventId)
      ) &&
        firestore.get(
          /databases/(default)/documents/events/$(eventId)
        ).data.status == 'published';
    }

    function canVisitEvent(eventId, visibility) {
      let eventPath = /databases/(default)/documents/events/$(eventId);
      return firestore.exists(eventPath) &&
        firestore.get(eventPath).data.status == 'published' &&
        firestore.get(eventPath).data.visibility == visibility &&
        'commercial' in firestore.get(eventPath).data &&
        firestore.get(eventPath).data.commercial.state == 'active' &&
        (firestore.get(eventPath).data.commercial.offerCode == 'public' ||
          (visibility == 'private' && firestore.get(eventPath).data.commercial.offerCode == 'private'));
    }

    function isEventPublic(eventId) {
      return canVisitEvent(eventId, 'public');
    }

    function hasActivePrivateLink(eventId, linkId) {
      let linkPath =
        /databases/(default)/documents/events/$(eventId)/privateLinks/$(linkId);

      return firestore.exists(linkPath) &&
        firestore.get(linkPath).data.expiresAt > request.time &&
        !('revokedAt' in firestore.get(linkPath).data);
    }

    function hasPrivateAccessGrantForUser(eventId, userId) {
      let grantPath =
        /databases/(default)/documents/events/$(eventId)/privateAccess/$(userId);

      return firestore.exists(/databases/(default)/documents/events/$(eventId)) &&
        canVisitEvent(eventId, 'private') &&
        firestore.exists(grantPath) &&
        firestore.get(grantPath).data.expiresAt > request.time &&
        (
          (
            firestore.get(grantPath).data.linkId is string &&
            hasActivePrivateLink(eventId, firestore.get(grantPath).data.linkId)
          ) ||
          (
            firestore.get(grantPath).data.accessVersion is number &&
            firestore.get(grantPath).data.accessVersion ==
              firestore.get(/databases/(default)/documents/events/$(eventId)).data.privateAccessVersion
          )
        );
    }

    function hasPrivateAccessGrant(eventId) {
      return isSignedIn() ? hasPrivateAccessGrantForUser(eventId, request.auth.uid) : false;
    }

    function getSignedInEventRole(eventId, userId) {
      let memberPath =
        /databases/(default)/documents/events/$(eventId)/members/$(userId);

      return firestore.exists(memberPath)
        ? firestore.get(memberPath).data.role
        : 'none';
    }

    function getEventRole(eventId) {
      return isSignedIn() ? getSignedInEventRole(eventId, request.auth.uid) : 'none';
    }

    function isEventAdmin(eventId) {
      return isSignedIn() &&
        (
          firestore.get(
            /databases/(default)/documents/events/$(eventId)
          ).data.adminId == request.auth.uid ||
          getEventRole(eventId) == 'admin' ||
          isOwner()
        );
    }

    function isAdminOrEditor(eventId) {
      let role = getEventRole(eventId);

      return role == 'admin' ||
             role == 'editor' ||
             isEventAdmin(eventId);
    }

    function isProgramPhotoAdmin(eventId) {
      let memberPath = /databases/(default)/documents/events/$(eventId)/members/$(request.auth.uid);
      return isSignedIn() && firestore.exists(memberPath) &&
        firestore.get(memberPath).data.role == 'admin';
    }

    function validProgramPhotoName(filename) {
      return filename.matches('^photo-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.(jpg|png|webp)$');
    }

    function validProgramPhotoUpload(filename) {
      return request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024 &&
        ((filename.matches('.*\\.jpg$') && request.resource.contentType == 'image/jpeg') ||
         (filename.matches('.*\\.png$') && request.resource.contentType == 'image/png') ||
         (filename.matches('.*\\.webp$') && request.resource.contentType == 'image/webp'));
    }

    match /events/{eventId}/program/{itemId}/{filename} {
      // Photo access intentionally has separate two-document read and write paths.
      allow read: if validProgramPhotoName(filename) && isEventPublic(eventId) &&
        firestore.exists(/databases/(default)/documents/events/$(eventId)/program/$(itemId)) &&
        firestore.get(/databases/(default)/documents/events/$(eventId)/program/$(itemId)).data.published == true &&
        'photoPath' in firestore.get(/databases/(default)/documents/events/$(eventId)/program/$(itemId)).data &&
        firestore.get(/databases/(default)/documents/events/$(eventId)/program/$(itemId)).data.photoPath ==
          'events/' + eventId + '/program/' + itemId + '/' + filename;

      allow create: if resource == null && validProgramPhotoName(filename) && validProgramPhotoUpload(filename) &&
        isEventPublic(eventId) && isProgramPhotoAdmin(eventId);
      allow delete: if validProgramPhotoName(filename) && isEventPublic(eventId) &&
        isProgramPhotoAdmin(eventId);
    }

    match /events/{eventId}/poi-images/{allPaths=**} {
      allow read: if isEventPublic(eventId) || isAdminOrEditor(eventId) || hasPrivateAccessGrant(eventId);
      allow write: if isAdminOrEditor(eventId);
    }

    match /events/{eventId}/event-cover/cover.jpg {
      allow read: if isEventPublic(eventId) || isAdminOrEditor(eventId) || hasPrivateAccessGrant(eventId);
      allow write: if isEventAdmin(eventId);
    }

    match /events/{eventId}/marketing/{allPaths=**} {
      allow read: if isEventPublic(eventId) || isAdminOrEditor(eventId) || hasPrivateAccessGrant(eventId);
      allow write: if isEventAdmin(eventId);
    }
  }
}
