rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(getUserId())).data;
    }

    // Utilisateur validé par owner
    function isApproved() {
      return isAuthenticated() &&
        getUserData().isApproved == true;
    }

    // Owner plateforme
    function isOwner() {
      return isAuthenticated() &&
        getUserData().role == "owner";
    }

    function getEvent(eventId) {
      return get(
        /databases/$(database)/documents/events/$(eventId)
      );
    }

    function isEventPublished(eventId) {
      let eventPath =
        /databases/$(database)/documents/events/$(eventId);

      return exists(eventPath) &&
        get(eventPath).data.status == "published";
    }

    function isEventPublic(eventId) {
      let eventPath =
        /databases/$(database)/documents/events/$(eventId);

      return exists(eventPath) &&
        get(eventPath).data.status == "published" &&
        get(eventPath).data.visibility == "public";
    }

    function hasActivePrivateLink(eventId, linkId) {
      let linkPath =
        /databases/$(database)/documents/events/$(eventId)/privateLinks/$(linkId);

      return exists(linkPath) &&
        get(linkPath).data.expiresAt > request.time &&
        !("revokedAt" in get(linkPath).data);
    }

    function hasPrivateAccessGrant(eventId) {
      let grantPath =
        /databases/$(database)/documents/events/$(eventId)/privateAccess/$(request.auth.uid);

      return isAuthenticated() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.status == "published" &&
        get(/databases/$(database)/documents/events/$(eventId)).data.visibility == "private" &&
        exists(grantPath) &&
        get(grantPath).data.expiresAt > request.time &&
        (
          (
            get(grantPath).data.linkId is string &&
            hasActivePrivateLink(eventId, get(grantPath).data.linkId)
          ) ||
          (
            get(grantPath).data.accessVersion is number &&
            get(grantPath).data.accessVersion ==
              get(/databases/$(database)/documents/events/$(eventId)).data.privateAccessVersion
          )
        );
    }

    function areReviewsEnabled(eventId) {
      let configPath =
        /databases/$(database)/documents/events/$(eventId)/config/main;

      return !exists(configPath) ||
        get(configPath).data.reviewsEnabled != false;
    }

    function hasReviewAccess(eventId) {
      return isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);
    }

    function isValidReviewCreate(poiId) {
      return request.resource.data.keys().hasOnly([
        "userId",
        "userName",
        "rating",
        "comment",
        "poiId",
        "createdAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "userId",
        "userName",
        "rating",
        "comment",
        "poiId",
        "createdAt"
      ]) &&
      request.resource.data.userId == getUserId() &&
      request.resource.data.poiId == poiId &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 &&
      request.resource.data.rating <= 5 &&
      request.resource.data.comment is string &&
      request.resource.data.comment.size() >= 10 &&
      request.resource.data.comment.size() <= 2000 &&
      request.resource.data.userName is string &&
      request.resource.data.userName.size() > 0 &&
      request.resource.data.userName.size() <= 40 &&
      request.resource.data.userName.matches("^[^\\s](.*[^\\s])?$") &&
      request.resource.data.createdAt == request.time;
    }

    function isValidReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "rating",
        "comment"
      ]) &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.poiId == resource.data.poiId &&
      request.resource.data.createdAt == resource.data.createdAt &&
      request.resource.data.userName == resource.data.userName &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 &&
      request.resource.data.rating <= 5 &&
      request.resource.data.comment is string &&
      request.resource.data.comment.size() >= 10 &&
      request.resource.data.comment.size() <= 2000;
    }

    function isEventMember(eventId) {
      return isAuthenticated() &&
        (
          exists(
            /databases/$(database)/documents/events/$(eventId)/members/$(getUserId())
          ) ||
          isOwner()
        );
    }

    function getRole(eventId) {
      return isEventMember(eventId)
        ? (
            isOwner()
              ? "admin"
              : get(
                  /databases/$(database)/documents/events/$(eventId)/members/$(getUserId())
                ).data.role
          )
        : null;
    }

    function isEventAdmin(eventId) {
      let role = getRole(eventId);

      return isAuthenticated() &&
        (
          role == "admin" ||
          getEvent(eventId).data.adminId == getUserId() ||
          isOwner()
        );
    }

    function isAdminOrEditor(eventId) {
      let role = getRole(eventId);

      return (
        role == "admin" ||
        role == "editor" ||
        isEventAdmin(eventId)
      );
    }

    function isValidEventRole(role) {
      return role == "admin" || role == "editor";
    }

    function isValidEventStatus(status) {
      return status == "draft" || status == "published" || status == "paused";
    }

    function isValidEventVisibility(visibility) {
      return visibility == "public" || visibility == "private";
    }

    function hasValidPoiGalleryLimit() {
      return !("galleryUrls" in request.resource.data) ||
        (
          request.resource.data.galleryUrls is list &&
          request.resource.data.galleryUrls.size() <= 3
        );
    }

    function hasValidPoiCategoryId() {
      return "categoryId" in request.resource.data &&
        request.resource.data.categoryId is string &&
        request.resource.data.categoryId.size() > 0 &&
        request.resource.data.categoryId.size() <= 80;
    }

    function hasValidEventMetadataFields() {
      return (
        !("description" in request.resource.data) ||
        (
          request.resource.data.description is string &&
          request.resource.data.description.size() <= 400
        )
      ) &&
      (
        !("eventCoverUrl" in request.resource.data) ||
        (
          request.resource.data.eventCoverUrl is string &&
          request.resource.data.eventCoverUrl.size() <= 2048
        )
      ) &&
      (
        !("privatePreviewEnabled" in request.resource.data) ||
        request.resource.data.privatePreviewEnabled is bool
      );
    }

    function isValidPoiCategory(category) {
      return category is map &&
        category.keys().hasOnly([
          "id",
          "label",
          "icon"
        ]) &&
        category.keys().hasAll([
          "id",
          "label",
          "icon"
        ]) &&
        category.id is string &&
        category.id.size() > 0 &&
        category.id.size() <= 80 &&
        category.label is string &&
        category.label.size() > 0 &&
        category.label.size() <= 40 &&
        category.icon is string &&
        category.icon.size() > 0 &&
        category.icon.size() <= 40;
    }

    function hasValidPoiCategoryAt(categories, index) {
      return categories.size() <= index ||
        isValidPoiCategory(categories[index]);
    }

    function hasValidPoiCategories() {
      return !("poiCategories" in request.resource.data) ||
        (
          request.resource.data.poiCategories is list &&
          request.resource.data.poiCategories.size() <= 20 &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 0) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 1) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 2) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 3) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 4) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 5) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 6) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 7) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 8) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 9) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 10) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 11) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 12) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 13) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 14) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 15) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 16) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 17) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 18) &&
          hasValidPoiCategoryAt(request.resource.data.poiCategories, 19)
        );
    }

    function doesNotEditPrivateAccessFields() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          "privateAccessTokenHash",
          "privateAccessVersion",
          "privateAccessTokenUpdatedAt",
          "privateAccessTokenRevokedAt"
        ]);
    }

    function canCreateEvent() {
      return isOwner();
    }

    /* =========================
       EVENTS ROOT
    ========================= */

    match /events/{eventId} {
      allow get: if
        (
          resource.data.status == "published" &&
          resource.data.visibility == "public"
        ) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow list: if
        isOwner() ||
        (
          resource.data.status == "published" &&
          resource.data.visibility == "public"
        ) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow create: if
        canCreateEvent() &&
        request.resource.data.adminId == getUserId() &&
        request.resource.data.status == "draft" &&
        isValidEventVisibility(request.resource.data.visibility) &&
        hasValidEventMetadataFields() &&
        hasValidPoiCategories();

      allow update: if isEventAdmin(eventId) &&
        isValidEventStatus(request.resource.data.status) &&
        isValidEventVisibility(request.resource.data.visibility) &&
        doesNotEditPrivateAccessFields() &&
        hasValidEventMetadataFields() &&
        hasValidPoiCategories();

      allow delete: if isEventAdmin(eventId);
    }

    match /events/{eventId}/privateAccess/{userId} {
      allow read, write: if false;
    }

    match /events/{eventId}/privateLinks/{linkId} {
      allow read, write: if false;
    }

    /* =========================
       MEMBERS
    ========================= */

    match /events/{eventId}/members/{userId} {
      // lecture équipe
      allow read: if isEventMember(eventId);

      allow create: if isAuthenticated() &&
        (
          isOwner() ||
          isEventAdmin(eventId)
        ) &&
        isValidEventRole(request.resource.data.role);

      allow update: if isEventAdmin(eventId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role"
        ]) &&
        isValidEventRole(request.resource.data.role);

      allow delete: if isEventAdmin(eventId);
    }

    // collectionGroup(members)
    match /{path=**}/members/{userId} {
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          (
            resource != null &&
            request.auth.uid == resource.data.uid
          ) ||
          isOwner()
        );
    }

    /* =========================
       POIS PUBLIC
    ========================= */

    match /events/{eventId}/pois_public/{poiId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow create, update: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit();

      allow delete: if
        isAdminOrEditor(eventId);
    }

    /* =========================
       POIS PRIVÉS
    ========================= */

    match /events/{eventId}/pois/{poiId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow create, update: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit();

      allow delete: if
        isAdminOrEditor(eventId);

      match /reviews/{reviewId} {
        allow read: if
          isEventPublic(eventId) ||
          isEventMember(eventId) ||
          hasPrivateAccessGrant(eventId);

        allow create: if
          areReviewsEnabled(eventId) &&
          isValidReviewCreate(poiId) &&
          (
            (
              isApproved() &&
              (
                isEventPublic(eventId) ||
                isEventMember(eventId)
              )
            ) ||
            hasPrivateAccessGrant(eventId)
          );

        allow update: if
          isAdminOrEditor(eventId) ||
          (
            isAuthenticated() &&
            resource != null &&
            request.auth.uid == resource.data.userId &&
            hasReviewAccess(eventId) &&
            isValidReviewUpdate()
          );

        allow delete: if
          isAdminOrEditor(eventId) ||
          (
            isAuthenticated() &&
            resource != null &&
            request.auth.uid == resource.data.userId &&
            hasReviewAccess(eventId)
          );
      }
    }

    /* =========================
       CONFIG EVENT
    ========================= */

    match /events/{eventId}/config/{docId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      // IMPORTANT :
      // autorise création initiale après création du document event
      allow create: if
        isOwner() ||
        isEventAdmin(eventId);

      allow update, delete: if
        isEventAdmin(eventId);
    }

    /* =========================
       CONFIG PORTAIL
    ========================= */

    match /config/{docId} {
      allow read: if true;

      allow write: if isOwner();
    }

    /* =========================
       USERS GLOBAL
    ========================= */

    match /users/{userId} {
      // confidentialité stricte
      allow read: if
        isAuthenticated() &&
        (
          request.auth.uid == userId ||
          isOwner()
        );

      allow create: if
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == "user" &&
        request.resource.data.isApproved == true;

      allow update: if
        isOwner() ||
        (
          request.auth.uid == userId &&
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'isApproved',
              'role'
            ])
        );
    }

    /* =========================
       LEGACY ROOT
    ========================= */

    match /pois/{poiId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /pois_public/{poiId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
