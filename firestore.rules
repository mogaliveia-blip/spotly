rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(getUserId())).data;
    }

    // Utilisateur validé par owner
    function isApproved() {
      return isAuthenticated() &&
        getUserData().isApproved == true;
    }

    // Owner plateforme
    function isOwner() {
      return isAuthenticated() &&
        getUserData().role == "owner";
    }

    function getEvent(eventId) {
      return get(
        /databases/$(database)/documents/events/$(eventId)
      );
    }

    function isEventPublished(eventId) {
      let eventPath =
        /databases/$(database)/documents/events/$(eventId);

      return exists(eventPath) &&
        get(eventPath).data.status == "published";
    }

    function canVisitEvent(data, visibility) {
      return data.status == "published" && data.visibility == visibility &&
        "commercial" in data && data.commercial is map &&
        data.commercial.state == "active" &&
        (data.commercial.offerCode == "public" ||
          (visibility == "private" && data.commercial.offerCode == "private"));
    }

    function isEventPublic(eventId) {
      let eventPath =
        /databases/$(database)/documents/events/$(eventId);

      return exists(eventPath) && canVisitEvent(get(eventPath).data, "public");
    }

    function hasActivePrivateLink(eventId, linkId) {
      let linkPath =
        /databases/$(database)/documents/events/$(eventId)/privateLinks/$(linkId);

      return exists(linkPath) &&
        get(linkPath).data.expiresAt > request.time &&
        !("revokedAt" in get(linkPath).data);
    }

    function hasPrivateAccessGrant(eventId) {
      let grantPath =
        /databases/$(database)/documents/events/$(eventId)/privateAccess/$(request.auth.uid);

      return isAuthenticated() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        canVisitEvent(get(/databases/$(database)/documents/events/$(eventId)).data, "private") &&
        exists(grantPath) &&
        get(grantPath).data.expiresAt > request.time &&
        (
          (
            get(grantPath).data.linkId is string &&
            hasActivePrivateLink(eventId, get(grantPath).data.linkId)
          ) ||
          (
            get(grantPath).data.accessVersion is number &&
            get(grantPath).data.accessVersion ==
              get(/databases/$(database)/documents/events/$(eventId)).data.privateAccessVersion
          )
        );
    }

    function areReviewsEnabled(eventId) {
      let configPath =
        /databases/$(database)/documents/events/$(eventId)/config/main;

      return !exists(configPath) ||
        get(configPath).data.reviewsEnabled != false;
    }

    function hasReviewAccess(eventId) {
      return isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);
    }

    function isValidReviewCreate(poiId) {
      return request.resource.data.keys().hasOnly([
        "userId",
        "userName",
        "rating",
        "comment",
        "poiId",
        "createdAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "userId",
        "userName",
        "rating",
        "comment",
        "poiId",
        "createdAt"
      ]) &&
      request.resource.data.userId == getUserId() &&
      request.resource.data.poiId == poiId &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 &&
      request.resource.data.rating <= 5 &&
      request.resource.data.comment is string &&
      request.resource.data.comment.size() >= 10 &&
      request.resource.data.comment.size() <= 2000 &&
      request.resource.data.userName is string &&
      request.resource.data.userName.size() > 0 &&
      request.resource.data.userName.size() <= 40 &&
      request.resource.data.userName.matches("^[^\\s](.*[^\\s])?$") &&
      request.resource.data.createdAt == request.time;
    }

    function isValidReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "rating",
        "comment"
      ]) &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.poiId == resource.data.poiId &&
      request.resource.data.createdAt == resource.data.createdAt &&
      request.resource.data.userName == resource.data.userName &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 &&
      request.resource.data.rating <= 5 &&
      request.resource.data.comment is string &&
      request.resource.data.comment.size() >= 10 &&
      request.resource.data.comment.size() <= 2000;
    }

    function isEventMember(eventId) {
      return isAuthenticated() &&
        (
          exists(
            /databases/$(database)/documents/events/$(eventId)/members/$(getUserId())
          ) ||
          isOwner()
        );
    }

    function getRole(eventId) {
      return isEventMember(eventId)
        ? (
            isOwner()
              ? "admin"
              : get(
                  /databases/$(database)/documents/events/$(eventId)/members/$(getUserId())
                ).data.role
          )
        : null;
    }

    function isEventAdmin(eventId) {
      let role = getRole(eventId);

      return isAuthenticated() &&
        (
          role == "admin" ||
          getEvent(eventId).data.adminId == getUserId() ||
          isOwner()
        );
    }

    function isAdminOrEditor(eventId) {
      let role = getRole(eventId);

      return (
        role == "admin" ||
        role == "editor" ||
        isEventAdmin(eventId)
      );
    }

    function isValidEventRole(role) {
      return role == "admin" || role == "editor";
    }

    function isValidEventStatus(status) {
      return status == "draft" || status == "published" || status == "paused";
    }

    function isValidEventVisibility(visibility) {
      return visibility == "public" || visibility == "private";
    }

    // IANA timezone and real Gregorian dates are validated by the dedicated Function.
    // Unchanged historical fields remain administrable; even owner clients cannot bypass validation.
    function doesNotEditEventTimeFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "timePrecision", "startDay", "endDay", "startDate", "endDate", "timezone"
      ]);
    }

    // Only the dedicated Function validates discovery data, even for owner clients.
    function doesNotEditEventDiscoveryFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "discoveryPosition", "typeId", "categoryId", "tags"
      ]);
    }

    // These changes must atomically maintain discovery_public, including owner clients.
    function doesNotEditEventProjectionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "name", "slug", "status", "visibility", "eventCoverUrl", "commercial",
        "deletionRequestedBy", "deletionRequestedAt"
      ]);
    }

    function hasValidEventTimeShape() {
      return !("timePrecision" in request.resource.data) ||
        (
          request.resource.data.timezone is string &&
          request.resource.data.timezone.size() > 0 &&
          request.resource.data.timezone.size() <= 100 &&
          (
            (
              request.resource.data.timePrecision == "date" &&
              request.resource.data.startDay is string &&
              request.resource.data.endDay is string &&
              request.resource.data.startDay.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
              request.resource.data.endDay.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
              request.resource.data.startDay <= request.resource.data.endDay &&
              !("startDate" in request.resource.data) && !("endDate" in request.resource.data)
            ) ||
            (
              request.resource.data.timePrecision == "datetime" &&
              request.resource.data.startDate is timestamp &&
              request.resource.data.endDate is timestamp &&
              request.resource.data.startDate <= request.resource.data.endDate &&
              !("startDay" in request.resource.data) && !("endDay" in request.resource.data)
            )
          )
        );
    }

    function hasValidPoiGalleryLimit() {
      return !("galleryUrls" in request.resource.data) ||
        (
          request.resource.data.galleryUrls is list &&
          request.resource.data.galleryUrls.size() <= 3
        );
    }

    function hasValidPoiCategoryId() {
      return "categoryId" in request.resource.data &&
        request.resource.data.categoryId is string &&
        request.resource.data.categoryId.size() > 0 &&
        request.resource.data.categoryId.size() <= 80;
    }

    // A partnership belongs to the platform owner, including when a Point is replaced or deleted.
    function hasNoSponsorAt(path) {
      return !exists(path) || !("sponsor" in get(path).data);
    }

    function canCreatePoiWithoutSponsor(otherPath) {
      return isOwner() ||
        (!("sponsor" in request.resource.data) && hasNoSponsorAt(otherPath));
    }

    function canUpdatePoiWithoutSponsorChange() {
      return isOwner() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["sponsor"]);
    }

    function canDeletePoiWithoutSponsor(otherPath) {
      return isOwner() ||
        (!("sponsor" in resource.data) && hasNoSponsorAt(otherPath));
    }

    function hasValidEventMetadataFields() {
      return (
        !("description" in request.resource.data) ||
        (
          request.resource.data.description is string &&
          request.resource.data.description.size() <= 400
        )
      ) &&
      (
        !("eventCoverUrl" in request.resource.data) ||
        (
          request.resource.data.eventCoverUrl is string &&
          request.resource.data.eventCoverUrl.size() <= 2048
        )
      ) &&
      (
        !("privatePreviewEnabled" in request.resource.data) ||
        request.resource.data.privatePreviewEnabled is bool
      );
    }

    function hasValidPoiCategories() {
      return !("poiCategories" in request.resource.data) ||
        (
          request.resource.data.poiCategories is list &&
          request.resource.data.poiCategories.size() <= 20
        );
    }

    function hasValidProgramDay(day) {
      return day is string && !day.matches("^0000-.*$") &&
        (day.matches(
          "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|" +
          "(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$") ||
        day.matches(
          "^([0-9]{2}(0[48]|[2468][048]|[13579][26])|" +
          "(0[48]|[2468][048]|[13579][26])00)-02-29$"));
    }

    function hasValidProgramItem(eventId, itemId) {
      let data = request.resource.data;
      return data.keys().hasAll(["name", "published", "sortOrder"]) &&
        data.keys().hasOnly([
          "name", "published", "sortOrder", "description", "photoPath",
          "day", "startTime", "endTime", "poiId"
        ]) &&
        data.name is string && data.name.size() <= 120 &&
        data.name.matches("^[^\\s](.*[^\\s])?$") &&
        data.published is bool &&
        data.sortOrder is int && data.sortOrder >= -1000000 && data.sortOrder <= 1000000 &&
        (!("description" in data) ||
          (data.description is string && data.description.size() <= 2000)) &&
        (!("photoPath" in data) ||
          (data.photoPath is string && data.photoPath.size() <= 500 &&
            data.photoPath.matches("^events/" + eventId + "/program/" + itemId +
              "/[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"))) &&
        (!("day" in data) || hasValidProgramDay(data.day)) &&
        (!("startTime" in data) ||
          ("day" in data && data.startTime is string &&
            data.startTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$"))) &&
        (!("endTime" in data) ||
          ("startTime" in data && data.endTime is string &&
            data.endTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$") &&
            data.endTime > data.startTime)) &&
        (!("poiId" in data) ||
          (data.poiId is string && data.poiId.size() > 0 && data.poiId.size() <= 150 &&
            data.poiId != "." && data.poiId != ".." && data.poiId.matches("^[^/]+$")));
    }

    function hasExistingProgramPoi(eventId) {
      return !("poiId" in request.resource.data) ||
        exists(/databases/$(database)/documents/events/$(eventId)/pois/$(request.resource.data.poiId));
    }

    function keepsOrLinksExistingProgramPoi(eventId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["poiId"]) ||
        hasExistingProgramPoi(eventId);
    }

    function doesNotEditPrivateAccessFields() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          "privateAccessTokenHash",
          "privateAccessVersion",
          "privateAccessTokenUpdatedAt",
          "privateAccessTokenRevokedAt"
        ]);
    }

    // L'owner conserve les champs d'autorité non projetés. Le résumé commercial
    // et les marqueurs de suppression exigent désormais une Function (garde ci-dessus).
    // Leur absence historique n'empêche pas les modifications ordinaires.
    function doesNotEditProtectedEventFields() {
      return isOwner() ||
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "createdBy",
            "creationRequestId",
            "adminId",
            "commercial",
            "capabilities",
            "coveredEndDate",
            "payment",
            "paymentId",
            "paymentProvider",
            "deletionRequestedBy",
            "deletionRequestedAt"
          ]);
    }

    /* =========================
       EVENTS ROOT
    ========================= */

    match /events/{eventId} {
      allow get: if
        canVisitEvent(resource.data, "public") ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow list: if
        isOwner() ||
        canVisitEvent(resource.data, "public") ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      // Toute création passe désormais par createEventDraft (Admin SDK).
      allow create: if false;

      allow update: if isEventAdmin(eventId) &&
        doesNotEditEventTimeFields() &&
        doesNotEditEventDiscoveryFields() &&
        doesNotEditEventProjectionFields() &&
        hasValidEventTimeShape() &&
        isValidEventStatus(request.resource.data.status) &&
        isValidEventVisibility(request.resource.data.visibility) &&
        doesNotEditPrivateAccessFields() &&
        doesNotEditProtectedEventFields() &&
        hasValidEventMetadataFields() &&
        hasValidPoiCategories();

      // Deletion must remove the projection before business cleanup.
      allow delete: if false;
    }

    match /discovery_public/{projectionId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow write: if false;
    }

    match /events/{eventId}/program/{itemId} {
      allow get, list: if isEventAdmin(eventId) ||
        (resource.data.published == true &&
          (isEventPublic(eventId) || hasPrivateAccessGrant(eventId)));

      allow create: if isEventAdmin(eventId) &&
        hasValidProgramItem(eventId, itemId) &&
        request.resource.data.published == false &&
        !("photoPath" in request.resource.data) &&
        hasExistingProgramPoi(eventId);

      allow update: if isEventAdmin(eventId) &&
        hasValidProgramItem(eventId, itemId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoPath"]) ||
          (resource.data.published == true && request.resource.data.published == true &&
            isEventPublic(eventId) && isAuthenticated() &&
            exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role == "admin")) &&
        keepsOrLinksExistingProgramPoi(eventId);

      allow delete: if isEventAdmin(eventId);
    }

    match /events/{eventId}/privateAccess/{userId} {
      allow read, write: if false;
    }

    match /events/{eventId}/privateLinks/{linkId} {
      allow read, write: if false;
    }

    /* =========================
       RÉSERVATIONS SERVEUR FUTURES
    ========================= */

    match /freeDraftSlots/{userId} {
      allow read, write: if false;
    }

    match /eventSlugs/{normalizedSlug} {
      allow read, write: if false;
    }

    /* =========================
       MEMBERS
    ========================= */

    match /events/{eventId}/members/{userId} {
      // lecture équipe
      allow read: if isEventMember(eventId);

      allow create: if isAuthenticated() &&
        (
          isOwner() ||
          isEventAdmin(eventId)
        ) &&
        isValidEventRole(request.resource.data.role);

      allow update: if isEventAdmin(eventId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role"
        ]) &&
        isValidEventRole(request.resource.data.role);

      allow delete: if isEventAdmin(eventId);
    }

    // collectionGroup(members)
    match /{path=**}/members/{userId} {
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          (
            resource != null &&
            request.auth.uid == resource.data.uid
          ) ||
          isOwner()
        );
    }

    /* =========================
       POIS PUBLIC
    ========================= */

    match /events/{eventId}/pois_public/{poiId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow create: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit() &&
        canCreatePoiWithoutSponsor(
          /databases/$(database)/documents/events/$(eventId)/pois/$(poiId));

      allow update: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit() &&
        canUpdatePoiWithoutSponsorChange();

      allow delete: if
        isAdminOrEditor(eventId) &&
        canDeletePoiWithoutSponsor(
          /databases/$(database)/documents/events/$(eventId)/pois/$(poiId));
    }

    /* =========================
       POIS PRIVÉS
    ========================= */

    match /events/{eventId}/pois/{poiId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      allow create: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit() &&
        canCreatePoiWithoutSponsor(
          /databases/$(database)/documents/events/$(eventId)/pois_public/$(poiId));

      allow update: if
        isAdminOrEditor(eventId) &&
        hasValidPoiCategoryId() &&
        hasValidPoiGalleryLimit() &&
        canUpdatePoiWithoutSponsorChange();

      allow delete: if
        isAdminOrEditor(eventId) &&
        canDeletePoiWithoutSponsor(
          /databases/$(database)/documents/events/$(eventId)/pois_public/$(poiId));

      match /reviews/{reviewId} {
        allow read: if
          isEventPublic(eventId) ||
          isEventMember(eventId) ||
          hasPrivateAccessGrant(eventId);

        allow create: if
          areReviewsEnabled(eventId) &&
          isValidReviewCreate(poiId) &&
          (
            (
              isApproved() &&
              (
                isEventPublic(eventId) ||
                isEventMember(eventId)
              )
            ) ||
            hasPrivateAccessGrant(eventId)
          );

        allow update: if
          isAdminOrEditor(eventId) ||
          (
            isAuthenticated() &&
            resource != null &&
            request.auth.uid == resource.data.userId &&
            hasReviewAccess(eventId) &&
            isValidReviewUpdate()
          );

        allow delete: if
          isAdminOrEditor(eventId) ||
          (
            isAuthenticated() &&
            resource != null &&
            request.auth.uid == resource.data.userId &&
            hasReviewAccess(eventId)
          );
      }
    }

    /* =========================
       CONFIG EVENT
    ========================= */

    match /events/{eventId}/config/{docId} {
      allow read: if
        isEventPublic(eventId) ||
        isEventMember(eventId) ||
        hasPrivateAccessGrant(eventId);

      // IMPORTANT :
      // autorise création initiale après création du document event
      allow create: if
        isOwner() ||
        isEventAdmin(eventId);

      allow update, delete: if
        isEventAdmin(eventId);
    }

    /* =========================
       CONFIG PORTAIL
    ========================= */

    match /config/{docId} {
      allow read: if true;

      allow write: if isOwner();
    }

    /* =========================
       USERS GLOBAL
    ========================= */

    match /users/{userId} {
      // confidentialité stricte
      allow read: if
        isAuthenticated() &&
        (
          request.auth.uid == userId ||
          isOwner()
        );

      allow create: if
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == "user" &&
        request.resource.data.isApproved == true;

      allow update: if
        isOwner() ||
        (
          request.auth.uid == userId &&
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'isApproved',
              'role'
            ])
        );
    }

    /* =========================
       LEGACY ROOT
    ========================= */

    match /pois/{poiId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /pois_public/{poiId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
